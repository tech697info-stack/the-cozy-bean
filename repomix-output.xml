    @apply bg-dark-roast text-primary font-sans antialiased overflow-x-hidden;
  }
  
  html {
    scroll-behavior: auto; /* Handled by Lenis */
  }
}

@layer components {
  .glass-panel {
    @apply bg-warm-cream/5 backdrop-blur-glass border border-warm-cream/10 shadow-glass rounded-[24px];
  }
  
  .glass-panel-hover {
    @apply transition-all duration-300 hover:bg-warm-cream/10 hover:border-warm-cream/20 hover:shadow-glass-hover hover:-translate-y-1;
  }
  
  .text-gradient {
    @apply bg-clip-text text-transparent bg-gradient-to-r from-amber-glow via-terracotta to-amber-glow;
  }
}

